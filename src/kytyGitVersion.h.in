#include "cmake_config.h"

#define KYTY_GIT_VERSION "@KYTY_GIT_VERSION@"
// Short, human-facing commit name used in build labels.
#define KYTY_GIT_HASH "@KYTY_GIT_HASH@"
// Full commit identity used for compatibility checks.
#define KYTY_GIT_REVISION "@KYTY_GIT_REVISION@"

// Shared identity for the library, emulator and crash reports.
#define KYTY_BUILD_LABEL "KytyPS5 " KYTY_GIT_VERSION
